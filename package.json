{
  "name": "reviewflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prepare:static-env": "node scripts/prepare-static-env.mjs",
    "dev": "npm run prepare:static-env && next dev static-client",
