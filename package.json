{
  "name": "reviewflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "predev": "node scripts/optimize-public-assets.mjs",
    "dev:firebase": "vite --config vite.config.ts",
    "predev:firebase": "node scripts/optimize-public-assets.mjs",
    "dev:next": "next dev",
    "build": "npm run build:firebase",
    "prebuild:firebase": "node scripts/optimize-public-assets.mjs",
    "build:next": "prisma generate && next build",
    "build:firebase": "vite build --config vite.config.ts",
    "preview:firebase": "vite preview --config vite.config.ts",
    "migrate:firestore": "tsx scripts/migrate-postgres-to-firestore.ts",
    "bootstrap:firebase-admin": "tsx scripts/bootstrap-firebase-super-admin.ts",
    "link:firebase-super-admin": "tsx scripts/link-firebase-super-admin.ts",
    "start": "vite preview --config vite.config.ts --host 0.0.0.0",
    "start:next": "next start",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@neon/config": "^1.8.3",
    "@prisma/client": "^6.19.0",
    "@vitejs/plugin-react": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "firebase": "^12.19.0",
    "jose": "^5.9.6",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.5",
    "sharp": "0.35.5",
    "vite": "^8.3.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.20",
    "firebase-admin": "^14.5.0",
    "postcss": "^8.4.47",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
